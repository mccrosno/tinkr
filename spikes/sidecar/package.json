{
  "name": "sidecar",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun index.ts",
    "build": "bun build index.ts --compile --target=bun-windows-x64 --outfile dist/tinkr-sidecar.exe",
    "build:slim": "bun build slim.ts --compile --target=bun-windows-x64 --outfile dist/tinkr-sidecar-slim.exe",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.331"
  }
}
