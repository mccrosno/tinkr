{
  "name": "tinkr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["sidecar"],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "tauri": "tauri",
    "app": "tauri dev",
    "typecheck": "vue-tsc --noEmit && bun run --cwd sidecar typecheck",
    "test": "bun test",
    "e2e": "bun e2e/chat.e2e.ts",
    "build:sidecar": "bun run --cwd sidecar build",
    "release": "bun run build:sidecar && tauri build --config src-tauri/tauri.release.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "markdown-it": "^14",
    "pinia": "^3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@types/markdown-it": "^14",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
